# Persistent local WhatsApp linked-device credential. Never commit the database.
NEONIZE_SESSION_DB=data/neonize-session.db

# Bot conversations, CRM contacts, users, meetings, and audit history.
BOT_DATABASE=data/mechman-bot.db

# Public URL sent by the WhatsApp bot when a visitor asks to book.
PUBLIC_BOOKING_URL=http://localhost:8000/book

# Generate a unique value with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=720

# Seeded only when the user does not already exist. Change these before first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Supported values: 30, 45, 60, 90, 120.
MEETING_DURATION_MINUTES=60

# Start the Neonize linked-device transport with the web server.
WHATSAPP_AUTOSTART=true

# Optional staff WhatsApp alert number, international digits only.
TEAM_ALERT_NUMBER=

LOG_LEVEL=INFO
